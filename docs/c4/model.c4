// C4 model of the agentbox repo — personal Claude Code plugin marketplace & tooling platform.
// Grounded in README.md, CLAUDE.md, CONTRIBUTING.md, .claude-plugin/marketplace.json,
// plugins/agentbox/ (19 skills, 10 agents, hooks, scripts). Source of truth: this file.

specification {
  element actor {
    style { shape person }
  }
  element system
  element external {
    style { color muted }
  }
  element container
  element component

  // Lineage / architectural pattern relationships
  relationship lineage {
    line dotted
    color muted
  }
}

model {
  dev = actor 'Developer' {
    description 'duythien0912 / engineer — installs agentbox marketplace, invokes skills by describing tasks, reviews generated artifacts and PRs'
  }

  claude = external 'Claude Code CLI' {
    technology 'CLI / Node.js'
    description 'Host runtime: registers marketplace, auto-discovers skills/agents from plugins/agentbox, evaluates frontmatter triggers, runs subagents and Workflow tool'
  }

  omp = external 'Oh My Pi (omp)' {
    technology 'Bun / Node.js VM'
    description 'Alternative host runtime: persistent JS kernel, workpool(), agent(), and hub coordination'
  }

  github = external 'GitHub' {
    technology 'Cloud Git / API'
    description 'Hosts duythien0912/agentbox, receives optimization and delivery PRs (never auto-merged), hosts issue tracker for user feedback'
  }

  dockerd = external 'Docker & Harbor' {
    technology 'Docker Daemon / microVMs'
    description 'Runs pinned toolchain containers (LikeC4 for c4-model) and containerized Tier-3 behavioral test runs via Harbor'
  }

  herdr = external 'Herdr Multiplexer' {
    technology 'tmux / CLI'
    description 'Multiplexes interactive agent processes across terminal panes and diverse AI harnesses (Claude, Pi, Codex, OpenCode)'
  }

  agentbox = system 'agentbox Platform' {
    description 'Personal Claude Code plugin marketplace & autonomous engineering toolkit: 19 skills, 10 subagents, session policy hooks, durable loops'

    manifest = container 'Plugin Manifest & Discovery' {
      technology 'JSON / .claude-plugin'
      description 'Declares plugin identity, marketplace registration, and auto-discovery routes for skills, agents, and hooks'
    }

    artifactSkills = container 'Visual & Artifact Skills' {
      technology 'SKILL.md + assets/ + templates'
      description 'Family 1: generates self-contained, interactive HTML visualizers, diagrams, and explanation decks'

      c4model = component 'c4-model' {
        technology 'LikeC4 DSL / Docker'
        description 'Builds multi-view interactive architecture diagrams (landscape → containers → components) into offline-viewable HTML'
      }
      flowchart = component 'flowchart' {
        technology 'Mermaid / HTML'
        description 'Interactive branching pipeline flowcharts with per-node inspector panels and headless syntax validator'
      }
      componentDiagram = component 'component-diagram' {
        technology 'Mermaid / HTML'
        description 'System component diagrams with boundary boxes, typed dependencies, and pan/zoom interaction'
      }
      sequenceDiagram = component 'sequence-diagram' {
        technology 'Mermaid / HTML'
        description 'Time-ordered interaction sequence diagrams with step-driven detail drawer'
      }
      prWriteup = component 'pr-writeup' {
        technology 'HTML / Tailwind'
        description 'Converts pull requests into self-contained reviewer tours with file diff breakdowns, risk analysis, and test plans'
      }
      codewalk = component 'codewalk' {
        technology 'HTML / CSS'
        description 'Traces execution paths through real codebases with verified file:line references and gotcha callouts'
      }
      planDeck = component 'plan-deck' {
        technology 'HTML / CSS'
        description 'Turns specifications into implementation decks with milestone timelines, data flows, and risk matrices'
      }
      deepUnderstanding = component 'deep-understanding' {
        technology 'Markdown / Tutor'
        description 'Interactive Socratic tutor: assesses knowledge gaps and quizzes the human until verified concept mastery'
      }
    }

    orchestrationLoops = container 'Orchestration Engines' {
      technology 'Pure JS Conductors + Subagent Workers'
      description 'Family 2: durable, crash-resumable workflow runners executing multi-agent pipelines with Definition-of-Done gates'

      conductor = component 'conductor' {
        technology 'scaffold-workflow.cjs / Workflow'
        description 'Durable workflow runner: disk-backed state (.workflows/), worktree isolation, Definition-of-Done gates, and artifact promotion'
      }
      loom = component 'loom' {
        technology 'scaffold-loom.cjs / Graph DAG'
        description 'Graph-shaped delivery engine: executes reshapeable DAGs with conditional back-edges, fork/rejoin invariant validation, and browser preview'
      }
      lanes = component 'lanes' {
        technology 'orch-lane.sh / DuckDB'
        description 'External-agent execution model: manages independent agent processes across panes/worktrees with append-only ledger and DuckDB views'
      }
      laneConfig = component 'lane-config' {
        technology 'orch-config.sh / JSON'
        description 'Per-project orchestration configuration: validates harness kinds, model policies, timeout caps, and worker profiles'
      }

      loom -[lineage]-> conductor 'extends conductor with reshapeable DAG back-edges'
      lanes -[lineage]-> conductor 'moves from in-session subagents to durable external processes'
    }

    evalOptEngines = container 'Eval & Optimization Engines' {
      technology 'Node.js / Harbor / Evals'
      description 'Family 3: automated hill-climbing, regression benchmarking, and plan pre-flight verification engines'

      prospector = component 'prospector' {
        technology 'scaffold-optimize.cjs'
        description 'Sequential keep-or-discard hill-climbing optimizer: optimizes a target metric against hard correctness gates on opt/ branches'
      }
      whetstone = component 'whetstone' {
        technology 'scaffold-improve.cjs'
        description 'Overnight eval-gated skill improver: grinds feedback/<skill>.jsonl against frozen baseline checks on improve/ branches'
      }
      arena = component 'arena' {
        technology 'scaffold-arena.cjs'
        description 'Pairwise tournament engine: evaluates competing conductor configurations across standardized fixtures to rank performance'
      }
      planCheck = component 'plan-check' {
        technology 'validate.mjs / 4-Quadrant'
        description 'Pre-flight plan auditor: verifies goal coverage, task graph DAG, blind spots, and execution shape before launch'
      }

      prospector -[lineage]-> conductor 'builds upon durable resume state machine'
      whetstone -[lineage]-> prospector 'replaces scalar metric hill-climb with discrimination-gated frozen checks'
      arena -[lineage]-> conductor 'benchmarks and scores conductor configurations across fixtures'
    }

    routerAndQuality = container 'Routing & Quality Control' {
      technology 'Node.js / Markdown'
      description 'Entry-point concierge router, static skill quality linter, and feedback harvesting'

      guide = component 'guide' {
        description 'Concierge router: maps developer JTBD requests to appropriate skills, suggests flags, and explains workflows'
      }
      skillLint = component 'skill-lint' {
        technology 'analyze.cjs'
        description 'Static analyzer for SKILL.md: checks verbosity budget, XML balance, trigger keyword quality, and asset sizing'
      }
      feedback = component 'feedback' {
        technology 'scrub.cjs'
        description 'Scans and scrubs session notes to file sanitized issues on GitHub that seed whetstone improvement backlogs'
      }
    }

    subagents = container 'Subagent Roster' {
      technology 'agents/*.md (System Prompts)'
      description '10 purpose-built subagents categorized into public direct-use agents and automated gate workers'

      planner = component 'agentbox-planner' {
        description 'Public agent: scopes goals into executable slices and observable command-level acceptance criteria'
      }
      builder = component 'agentbox-builder' {
        description 'Public agent: implements scoped slices inside isolated worktrees, stopping at first red condition'
      }
      verifier = component 'agentbox-verifier' {
        description 'Public agent: objectively verifies slice results against acceptance criteria at target SHA without fixing'
      }
      codeReviewer = component 'agentbox-code-reviewer' {
        description 'Public agent: reviews code changes for critical/high defects and fixes them while maintaining green build'
      }
      testWriter = component 'agentbox-test-writer' {
        description 'Gate worker: writes failing tests (RED-first) from acceptance criteria prior to implementation'
      }
      tryveEnhancer = component 'agentbox-tryve-enhancer' {
        description 'Gate worker: hardens test coverage on diffs, targeting boundary cases, auth, errors, and concurrency'
      }
      docsWriter = component 'agentbox-docs-writer' {
        description 'Gate worker: writes concise implementation notes into docs/changes/ from diffs and goals'
      }
      webVerifier = component 'agentbox-web-verifier' {
        technology 'Playwright / Puppeteer'
        description 'Gate worker: writes Playwright E2E tests and captures multi-viewport screenshot and console evidence'
      }
      mobileVerifier = component 'agentbox-mobile-verifier' {
        technology 'Maestro / Appium / simctl / adb'
        description 'Gate worker: detects mobile stacks and verifies mobile flows or raw UI evidence'
      }
      herdrOrchestrator = component 'agentbox-herdr-orchestrator' {
        technology 'tmux / Herdr'
        description 'Orchestrator agent: manages external panes, dispatches tasks to panes, adjudicates evidence, and advances lanes'
      }
    }

    policyHooks = container 'Session Policy Hooks' {
      technology 'hooks.json + Zsh/Bash'
      description 'Lifecycle hooks intercepting PreToolUse, PostToolUse, and Stop events to enforce safety, policy, and DoD gates'

      paneGuard = component 'pane-guard.sh' {
        description 'PreToolUse Bash hook: prevents orchestrator agents from illegally editing implementation code directly'
      }
      modelPolicy = component 'model-policy.sh' {
        description 'PreToolUse Bash hook: enforces declared model and effort profiles from orchestration config'
      }
      gateGuard = component 'gate-guard.sh' {
        description 'PreToolUse Bash hook: validates evidence and criteria satisfaction before allowing phase progression'
      }
      laneLedger = component 'lane-ledger.sh' {
        description 'PostToolUse Bash hook: automatically logs tool execution events to run ledger'
      }
      laneGate = component 'lane-gate.sh' {
        description 'Stop hook: blocks session exit when unfinished work or unverified gates remain'
      }
    }

    runtimeState = container 'Runtime Stores & Worktrees' {
      technology 'JSON / DuckDB / Git Worktrees'
      description 'Git-ignored durable execution state, append-only ledgers, DuckDB views, and isolated checkouts'
    }
  }

  // Inter-system and Container Interactions
  dev -> claude 'invokes skills via prompt / triggers' 'CLI'
  dev -> omp 'runs workflows via persistent VM' 'CLI'
  dev -> github 'reviews & merges pull requests' 'HTTPS'

  claude -> agentbox.manifest 'reads plugin configuration & triggers' 'JSON'
  omp -> agentbox.manifest 'links skills & agents via setup-omp.sh' 'Symlink'

  claude -> agentbox.routerAndQuality 'routes requests via'
  claude -> agentbox.artifactSkills 'executes to produce visual output'
  claude -> agentbox.orchestrationLoops 'launches multi-agent workflows'
  claude -> agentbox.evalOptEngines 'launches optimization & audit runs'
  claude -> agentbox.subagents 'spawns specialized agents'
  claude -> agentbox.policyHooks 'triggers lifecycle intercepts' 'STDIN/STDOUT'

  agentbox.artifactSkills.c4model -> dockerd 'executes LikeC4 compiler container' 'Docker CLI'
  agentbox.evalOptEngines -> dockerd 'executes behavioral test containers' 'Harbor CLI'

  agentbox.orchestrationLoops.conductor -> agentbox.runtimeState 'persists checkpoint state to .workflows/' 'JSON'
  agentbox.orchestrationLoops.lanes -> agentbox.runtimeState 'records ledger & queries DuckDB in .orchestration/' 'DuckDB / JSON'
  agentbox.orchestrationLoops.lanes -> herdr 'spawns & manages external agent panes' 'CLI'
  agentbox.orchestrationLoops.conductor -> agentbox.subagents 'dispatches gate workers'
  agentbox.orchestrationLoops.lanes -> agentbox.subagents.herdrOrchestrator 'runs as execution driver'

  agentbox.evalOptEngines.prospector -> github 'opens optimization PR (no auto-merge)' 'gh CLI'
  agentbox.evalOptEngines.whetstone -> github 'opens skill improvement PR (no auto-merge)' 'gh CLI'
  agentbox.evalOptEngines.arena -> github 'opens leaderboard PR' 'gh CLI'
  agentbox.routerAndQuality.feedback -> github 'files sanitized issue' 'gh CLI'

  agentbox.routerAndQuality.skillLint -> agentbox.artifactSkills 'statically lints SKILL.md'
  agentbox.routerAndQuality.skillLint -> agentbox.orchestrationLoops 'statically lints SKILL.md'
  agentbox.routerAndQuality.skillLint -> agentbox.evalOptEngines 'statically lints SKILL.md'
}

views {
  view index {
    title 'agentbox — System Landscape (Level 1 Context)'
    include *
  }

  view of agentbox {
    title 'agentbox Platform — Containers (Level 2)'
    include *, dev, claude, omp, github, dockerd, herdr
  }

  view of agentbox.artifactSkills {
    title 'Visual & Artifact Skills — Components (Level 3)'
    include *, claude, dockerd
  }

  view of agentbox.orchestrationLoops {
    title 'Orchestration Engines — Components (Level 3)'
    include *, claude, herdr, agentbox.runtimeState, agentbox.subagents
  }

  view of agentbox.evalOptEngines {
    title 'Eval & Optimization Engines — Components (Level 3)'
    include *, claude, github, dockerd, agentbox.orchestrationLoops.conductor
  }

  view of agentbox.subagents {
    title 'Subagent Roster — Components (Level 3)'
    include *, claude, agentbox.orchestrationLoops
  }

  view of agentbox.policyHooks {
    title 'Session Policy Hooks — Components (Level 3)'
    include *, claude, agentbox.orchestrationLoops
  }
}
